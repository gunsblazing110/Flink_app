rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isLoggedIn()   { return request.auth != null; }
    function isHqAdmin()    { return isLoggedIn() && getRole() == 'hq_admin'; }
    function isHubManager() { return isLoggedIn() && getRole() == 'hub_manager'; }

    match /users/{uid} {
      allow read:  if request.auth.uid == uid;
      allow write: if isHqAdmin();
    }
    match /recipes/{recipeId} {
      allow read:                   if isLoggedIn();
      allow create, update, delete: if isHqAdmin();
    }
    match /app_features/{featureId} {
      allow read, write: if isHqAdmin();
    }
    match /hub_inventory/{itemId} {
      allow read:  if isLoggedIn();
      allow write: if isHqAdmin() || isHubManager();
    }
  }
}
